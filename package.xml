<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>opennav_following</name>
  <version>1.0.0</version>
  <description>
    Jazzy-compatible backport of Nav2's dynamic object following action server
    (opennav_following, originally developed for the navigation2 "main" branch
    by Open Navigation LLC and Alberto J. Tudela Roldán). Self-contained: ships
    its own FollowObject action so it installs standalone on ROS 2 Jazzy.
  </description>
  <!-- TODO: preencher com seu nome antes de publicar -->
  <maintainer email="marcos.skatevelho@gmail.com">SEU NOME AQUI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>nav2_common</build_depend>
  <build_depend>angles</build_depend>

  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_util</depend>
  <depend>opennav_docking</depend>
  <depend>opennav_docking_core</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rosidl_default_generators</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
